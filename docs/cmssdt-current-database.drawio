<mxfile host="app.diagrams.net" modified="2026-08-13T00:00:00.000Z" agent="GitHub Copilot" version="24.7.17">
  <diagram id="cmssdt-current-database" name="Current Neo4j Database">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="CMSSDT Neo4j Database: How Local Evidence Connects" style="text;html=1;align=left;verticalAlign=middle;fontSize=27;fontStyle=1;fontColor=#173B5C;" vertex="1" parent="1"><mxGeometry x="45" y="24" width="1120" height="38" as="geometry"/></mxCell>
        <mxCell id="subtitle" value="All data is supplied locally. The importer does not call GitHub; it records only explicit evidence from local files." style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontColor=#617385;" vertex="1" parent="1"><mxGeometry x="47" y="65" width="1250" height="24" as="geometry"/></mxCell>

        <mxCell id="coreLane" value="01  BUILD AND WORKFLOW RESULTS" style="swimlane;html=1;horizontal=1;startSize=32;rounded=1;fillColor=#F7FAFC;swimlaneFillColor=#E7F0F8;strokeColor=#A9C3D8;fontColor=#275474;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="45" y="120" width="690" height="510" as="geometry"/></mxCell>
        <mxCell id="ib" value="&lt;b&gt;IB&lt;/b&gt;&lt;br&gt;&lt;font color='#526B7D'&gt;Integration Build&lt;br&gt;tag + architecture&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=14;fillColor=#FFFFFF;strokeColor=#5A9BC7;strokeWidth=2;shadow=1;" vertex="1" parent="1"><mxGeometry x="85" y="205" width="160" height="82" as="geometry"/></mxCell>
        <mxCell id="relval" value="&lt;b&gt;RelVal&lt;/b&gt;&lt;br&gt;&lt;font color='#526B7D'&gt;workflow ID, result,&lt;br&gt;errors and warnings&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=14;fillColor=#FFFFFF;strokeColor=#5A9BC7;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="325" y="175" width="175" height="88" as="geometry"/></mxCell>
        <mxCell id="command" value="&lt;b&gt;WorkflowCommand&lt;/b&gt;&lt;br&gt;&lt;font color='#526B7D'&gt;workflow step&lt;br&gt;command hash&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=14;fillColor=#FFFFFF;strokeColor=#5A9BC7;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="545" y="175" width="155" height="88" as="geometry"/></mxCell>
        <mxCell id="exception" value="&lt;b&gt;RelValException&lt;/b&gt;&lt;br&gt;&lt;font color='#526B7D'&gt;exception text&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=13;fillColor=#FFFFFF;strokeColor=#5A9BC7;" vertex="1" parent="1"><mxGeometry x="330" y="365" width="165" height="62" as="geometry"/></mxCell>
        <mxCell id="test" value="&lt;b&gt;UnitTest&lt;/b&gt;&lt;br&gt;&lt;font color='#526B7D'&gt;pass/fail and errors&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=13;fillColor=#FFFFFF;strokeColor=#5A9BC7;" vertex="1" parent="1"><mxGeometry x="105" y="470" width="150" height="62" as="geometry"/></mxCell>
        <mxCell id="package" value="&lt;b&gt;Package&lt;/b&gt;&lt;br&gt;&lt;font color='#526B7D'&gt;CMSSW package name&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=13;fillColor=#FFFFFF;strokeColor=#5A9BC7;" vertex="1" parent="1"><mxGeometry x="350" y="470" width="150" height="62" as="geometry"/></mxCell>
        <mxCell id="coreNote" value="One workflow can be recorded for many IB and architecture combinations. Each record remains distinct." style="shape=note;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=12;fontColor=#275474;fillColor=#EDF6FC;strokeColor=#A9C3D8;" vertex="1" parent="1"><mxGeometry x="515" y="455" width="175" height="72" as="geometry"/></mxCell>

        <mxCell id="provenanceLane" value="02  LOCAL PR-COMMAND PROVENANCE" style="swimlane;html=1;horizontal=1;startSize=32;rounded=1;fillColor=#FBFCF9;swimlaneFillColor=#E7F1DF;strokeColor=#A7C394;fontColor=#466C2C;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="775" y="120" width="780" height="510" as="geometry"/></mxCell>
        <mxCell id="commit" value="&lt;b&gt;Commit&lt;/b&gt;&lt;br&gt;&lt;font color='#4E6E55'&gt;full supplied SHA&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=14;fillColor=#FFFFFF;strokeColor=#72A46E;strokeWidth=2;shadow=1;" vertex="1" parent="1"><mxGeometry x="1035" y="180" width="170" height="72" as="geometry"/></mxCell>
        <mxCell id="pr" value="&lt;b&gt;PR&lt;/b&gt;&lt;br&gt;&lt;font color='#4E6E55'&gt;number, title, author&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=14;fillColor=#FFFFFF;strokeColor=#72A46E;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1320" y="180" width="165" height="72" as="geometry"/></mxCell>
        <mxCell id="author" value="&lt;b&gt;Author&lt;/b&gt;&lt;br&gt;&lt;font color='#4E6E55'&gt;CMS username&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=13;fillColor=#FFFFFF;strokeColor=#72A46E;" vertex="1" parent="1"><mxGeometry x="1325" y="365" width="155" height="58" as="geometry"/></mxCell>
        <mxCell id="matchRule" value="&lt;b&gt;Evidence rule&lt;/b&gt;&lt;br&gt;&lt;font color='#4E6E55'&gt;A command connects to a commit only when its 16-character hash exactly matches one unique supplied commit prefix.&lt;/font&gt;" style="shape=note;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=13;fillColor=#F2F8EE;strokeColor=#72A46E;" vertex="1" parent="1"><mxGeometry x="860" y="365" width="350" height="88" as="geometry"/></mxCell>
        <mxCell id="noGuess" value="No exact match: retain the workflow command, but do not name a PR." style="shape=note;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=13;fontColor=#8E2B1F;fillColor=#FFF1ED;strokeColor=#E3A292;" vertex="1" parent="1"><mxGeometry x="860" y="490" width="350" height="50" as="geometry"/></mxCell>
        <mxCell id="cacheSource" value="&lt;b&gt;cmsrepo/cmssw-prs-cache.json&lt;/b&gt;&lt;br&gt;&lt;font color='#4E6E55'&gt;Local PR-to-commit mapping&lt;/font&gt;" style="shape=document;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=13;fillColor=#FFFFFF;strokeColor=#72A46E;" vertex="1" parent="1"><mxGeometry x="1265" y="480" width="235" height="72" as="geometry"/></mxCell>

        <mxCell id="optionalLane" value="03  OPTIONAL LOCAL EVIDENCE LAYERS" style="swimlane;html=1;horizontal=1;startSize=32;rounded=1;fillColor=#FAF8FC;swimlaneFillColor=#EAE0F1;strokeColor=#A788B7;fontColor=#67457A;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="45" y="670" width="1510" height="250" as="geometry"/></mxCell>
        <mxCell id="issue" value="&lt;b&gt;Issue / PR discussion&lt;/b&gt;&lt;br&gt;&lt;font color='#5B4B68'&gt;Issue, GitHubComment, Label&lt;br&gt;from a supplied local archive&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=14;fillColor=#FFFFFF;strokeColor=#A788B7;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="120" y="765" width="245" height="82" as="geometry"/></mxCell>
        <mxCell id="reference" value="&lt;b&gt;REFERENCES&lt;/b&gt;&lt;br&gt;&lt;font color='#5B4B68'&gt;A body/comment mentions&lt;br&gt;another PR or Issue&lt;/font&gt;" style="shape=note;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=13;fillColor=#FFFFFF;strokeColor=#A788B7;" vertex="1" parent="1"><mxGeometry x="470" y="770" width="215" height="72" as="geometry"/></mxCell>
        <mxCell id="warning" value="&lt;b&gt;Compiler warnings&lt;/b&gt;&lt;br&gt;&lt;font color='#5B4B68'&gt;Warning, SourceFile, Checker&lt;br&gt;from local Clang logs&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=14;fillColor=#FFFFFF;strokeColor=#A788B7;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="810" y="765" width="245" height="82" as="geometry"/></mxCell>
        <mxCell id="tracking" value="&lt;b&gt;ImportState&lt;/b&gt;&lt;br&gt;&lt;font color='#5B4B68'&gt;file hash and import time&lt;br&gt;unchanged sources are skipped&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=14;fillColor=#FFFFFF;strokeColor=#A788B7;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1170" y="765" width="245" height="82" as="geometry"/></mxCell>
        <mxCell id="optionalNote" value="These layers are available only when their local source files are provided." style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontColor=#67457A;" vertex="1" parent="1"><mxGeometry x="395" y="870" width="800" height="24" as="geometry"/></mxCell>

        <mxCell id="e1" value="RAN_RELVAL" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeWidth=2;strokeColor=#5A9BC7;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="ib" target="relval"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" value="USED_COMMAND" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeWidth=2;strokeColor=#5A9BC7;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="relval" target="command"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3" value="HAS_EXCEPTION" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeWidth=2;strokeColor=#5A9BC7;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="relval" target="exception"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e4" value="RAN_UNITTEST" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeWidth=2;strokeColor=#5A9BC7;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="ib" target="test"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e5" value="IN_PACKAGE" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeWidth=2;strokeColor=#5A9BC7;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="test" target="package"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e6" value="MATCHES_CACHE_COMMIT&quot; exact only" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeWidth=3;strokeColor=#72A46E;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="command" target="commit"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="755" y="220"/><mxPoint x="755" y="105"/><mxPoint x="1120" y="105"/></Array></mxGeometry></mxCell>
        <mxCell id="e7" value="MERGED_AS" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeWidth=2;strokeColor=#72A46E;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="pr" target="commit"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e8" value="AUTHORED_BY" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeWidth=2;strokeColor=#72A46E;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="pr" target="author"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e9" value="supplied mapping" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeWidth=2;strokeColor=#72A46E;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="cacheSource" target="commit"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e10" value="may mention" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeWidth=2;strokeColor=#A788B7;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="issue" target="reference"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e11" value="warning evidence for an IB" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeWidth=2;strokeColor=#A788B7;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="warning" target="ib"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="930" y="700"/><mxPoint x="165" y="700"/><mxPoint x="165" y="300"/></Array></mxGeometry></mxCell>
        <mxCell id="e12" value="hashes every local source" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;dashed=1;strokeWidth=2;strokeColor=#A788B7;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="tracking" target="cacheSource"><mxGeometry relative="1" as="geometry"/></mxCell>
