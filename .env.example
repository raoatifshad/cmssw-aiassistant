# CERN LiteLLM gateway
CERN_API_BASE=https://REPLACE/v1
CERN_API_KEY=REPLACE
CERN_MODEL=hf-qwen3-32b-awq

# Neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=cmssdt2026

# Log RAG evidence archive (local path; mount this persistently in production)
LOG_RAG_ARCHIVE_DIR=data/log-rag
MAX_INGEST_BYTES=33554432
LOG_RAG_API_PORT=8002

# Optional raw-event retrieval index (Docker Compose sets these automatically)
OPENSEARCH_URL=http://localhost:9200
OPENSEARCH_INDEX=cmssdt-log-events

# Router/answer-synthesis experiments (each costs a real LLM call per message).
# ENABLE_ROUTER_SHADOW: logs an independent LLM classification of every
# question next to the deterministic router's choice (RouterShadowLog nodes),
# purely for comparison -- never used to answer. Summarize accumulated
# disagreement with ingestion/summarize_router_shadow.py before ever
# considering promoting an LLM router to primary.
# ENABLE_ANSWER_SYNTHESIS: LLM rephrases an already-deterministic answer,
# verified to preserve every number in it before being shown.
ENABLE_ROUTER_SHADOW=false
ENABLE_ANSWER_SYNTHESIS=false

# Shifter-only /shift page (shift summary digest + live alerts). Requires this
# app to be registered on CERN's Application Portal
# (https://application-portal.web.cern.ch/) first -- that registration step
# cannot be automated, it needs your CERN admin access. The redirect URI you
# register there must exactly match CERN_SSO_REDIRECT_URI below. Verify
# CERN_SSO_DISCOVERY_URL is still current in CERN's SSO docs before relying
# on it in production. SESSION_SECRET_KEY signs the login session cookie --
# generate a real random value (e.g. `openssl rand -hex 32`), never reuse the
# repo default. SHIFTER_CERN_USERNAMES is a comma-separated allowlist of CERN
# usernames (lowercase, matching the OIDC preferred_username claim) permitted
# to view the page; everyone else is refused even after a successful CERN
# login.
CERN_SSO_DISCOVERY_URL=https://auth.cern.ch/auth/realms/cern/.well-known/openid-configuration
CERN_SSO_CLIENT_ID=REPLACE
CERN_SSO_CLIENT_SECRET=REPLACE
CERN_SSO_REDIRECT_URI=http://localhost:8001/shift/auth/callback
SESSION_SECRET_KEY=REPLACE
SHIFTER_CERN_USERNAMES=

# Local laptop testing only, before the Application Portal registration exists:
# set DEV_SHIFTER_LOGIN=true to enable GET /shift/dev-login?username=<name>,
# which sets the session directly with no CERN round trip. <name> still has to
# be in SHIFTER_CERN_USERNAMES above -- the allowlist check is identical to
# production, only the "prove who you are" step is faked. NEVER set this to
# true anywhere but your own laptop; leave it unset (or false) everywhere else.
DEV_SHIFTER_LOGIN=false
