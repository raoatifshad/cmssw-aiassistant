# Copy to .env and fill in. .env holds secrets: never commit it.

# --- where everything is stored on the host (the separate data disk on the VM)
DATA_DIR=/srv/kg-data

# --- ports on the host
API_PORT=8001
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687

# --- Neo4j
NEO4J_PASSWORD=change-me
# memory: small for a test on a PC; on a 16 GB VM e.g. NEO4J_HEAP=4g, NEO4J_PAGECACHE=6g
NEO4J_HEAP=512m
NEO4J_PAGECACHE=512m

# --- CERN LLM gateway (same as the main .env)
CERN_API_BASE=
CERN_API_KEY=
CERN_MODEL=glm-5.3-flash-int4
ENABLE_AI_SUPERVISOR=true
ENABLE_ROUTER_SHADOW=true
ENABLE_CAPABILITY_FALLBACK_TO_LLM=true
ENABLE_DETERMINISTIC_ANSWER_VERIFICATION=true

# --- Shift Console login
SESSION_SECRET_KEY=
DEV_SHIFTER_LOGIN=false
SHIFTER_CERN_USERNAMES=

# --- backups (backup.sh / restore.sh)
BACKUP_KEEP=14
# EOS copy: off for now; later e.g. BACKUP_EOS_ENABLED=1, BACKUP_EOS_DIR=/eos/user/x/xyz/kg-backups
BACKUP_EOS_ENABLED=0
BACKUP_EOS_DIR=
